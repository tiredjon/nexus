# Скопируй в .env и подставь ключи Gemini (AI Studio).
#
# Первый ключ в списке — ОСНОВНОЙ: он обслуживает все запросы (ротации нет).
# Остальные подхватываются только как failover, если основной вернул ошибку/лимит.
# Для прода/демо ставь первым один платный ключ с нормальным rate-limit —
# тогда 429 практически исключён. Свободные ключи можно оставить запасными.
GEMINI_API_KEYS=paid-key-first,optional-backup-key-2
GEMINI_MODEL=gemini-3.5-flash
