      "checkConstraints": {
        "people_age_check": {
          "name": "people_age_check",
          "value": "\"people\".\"age\" BETWEEN 18 AND 30"
        },
        "people_gender_check": {
          "name": "people_gender_check",
          "value": "\"people\".\"gender\" IN ('Мужской','Женский')"
        },
        "people_status_check": {
          "name": "people_status_check",
          "value": "\"people\".\"status\" IN ('Работает','Безработный','Учится','Предприниматель','Другая деятельность','Статус не уточнён','Направлен на программу')"
        },
        "people_education_level_check": {
          "name": "people_education_level_check",
          "value": "\"people\".\"education_level\" IN ('Среднее','Среднее специальное','Колледж','Бакалавр','Магистр')"
        },
        "people_desired_direction_check": {
          "name": "people_desired_direction_check",
          "value": "\"people\".\"desired_direction\" IN ('Трудоустройство','Профессиональное обучение','Предпринимательство','Возвращение к обучению','Не определился')"
        },
        "people_marital_status_check": {
          "name": "people_marital_status_check",
          "value": "\"people\".\"marital_status\" IN ('Не женат/не замужем','Женат/замужем')"
        },
        "people_update_source_check": {
          "name": "people_update_source_check",
          "value": "\"people\".\"last_update_source\" IN ('Подворный обход','Самообращение','Синхронизация реестра','Телефонный звонок','Уточнение данных','Обращение махаллинского комитета')"
        },
        "people_neet_review_check": {
          "name": "people_neet_review_check",
          "value": "\"people\".\"neet_review_status\" IN ('Ожидает проверки','На уточнении','Подтверждено','Флаг снят')"
        },
        "people_program_check": {
          "name": "people_program_check",
          "value": "\"people\".\"program\" IS NULL OR \"people\".\"program\" IN ('Профессиональное обучение','Содействие в трудоустройстве','Программа поддержки бизнеса','Возвращение к обучению','Молодёжная стажировка')"
        },
        "people_program_outcome_check": {
          "name": "people_program_outcome_check",
          "value": "\"people\".\"program_outcome\" IS NULL OR \"people\".\"program_outcome\" IN ('Ожидает','Приступил','Завершил','Трудоустроен','Не явился','Отказался')"
        },
        "people_outcome_check": {
          "name": "people_outcome_check",
          "value": "\"people\".\"outcome\" IS NULL OR \"people\".\"outcome\" IN ('Трудоустроен','Учится','В процессе')"
        }
      },
