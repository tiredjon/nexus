          "value": "\"people\".\"neet_review_status\" IN ('Ожидает проверки','На уточнении','Подтверждено','Флаг снят')"
        },
        "people_program_check": {
          "name": "people_program_check",
          "value": "\"people\".\"program\" IS NULL OR \"people\".\"program\" IN ('Профессиональное обучение','Содействие в трудоустройстве','Программа поддержки бизнеса','Возвращение к обучению','Молодёжная стажировка')"
        },
